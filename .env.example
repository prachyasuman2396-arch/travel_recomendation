# ---------------------------------------------------------------------------
# Tourist Place Recommender — environment configuration
# Copy to .env and fill in what you have. Every external key is OPTIONAL:
# with no keys the app runs fully on clearly-labelled MOCK data + a mock LLM.
# Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                  # structured JSON logs (false = human-readable)

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
POSTGRES_USER=tourist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tourist
# Inside docker compose the host is "db"; for local runs use localhost:5432
DATABASE_URL=postgresql+psycopg://tourist:change-me@db:5432/tourist
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- API / security --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Required to use /api/v1/admin/* endpoints. Generate e.g. `openssl rand -hex 32`
ADMIN_API_TOKEN=
API_TIMEOUT=30

# --- Data collection (live providers are disabled when the key is empty) ---
PLACES_API_KEY=
FLICKR_API_KEY=
FLICKR_API_SECRET=
YELP_API_KEY=
# Yelp API terms restrict how long you may store their content (business IDs excepted).
YELP_CONTENT_RETENTION_HOURS=24
# Persist raw provider responses under data/raw/<provider>/ (only enable where the provider's terms allow it)
RAW_STORE_PLACES=false
RAW_STORE_FLICKR=true
RAW_STORE_YELP=false
RAW_STORE_OSM=true
# Sources run by scripts/ingest.py by default (yelp/flickr are optional, run only when asked)
DEFAULT_INGEST_SOURCES=places,osm,wikipedia
# Google reviews + goodForChildren are billed at the Enterprise+Atmosphere SKU. Off = cheaper.
PLACES_INCLUDE_REVIEWS=true
# Google content (reviews etc.) older than this is purged by the freshness agent
GOOGLE_CONTENT_RETENTION_DAYS=30

# --- India knowledge sources (keyless) ----------------------------------------
# OSM Overpass (Odia/Hindi names, wheelchair, fees). Respect the public server's usage policy.
OVERPASS_URL=https://overpass-api.de/api/interpreter
WIKIPEDIA_LANGUAGE=en
# Included in the User-Agent for Overpass/Wikimedia, as their policies ask. Recommended.
CONTACT_EMAIL=

# --- LLM providers (Gemini primary, Groq fallback; OpenAI is NOT used) ------
# gemini | groq | mock   (mock = deterministic offline responses, labelled as mock)
LLM_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current stable model codes
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
# Must support Structured Outputs: https://console.groq.com/docs/structured-outputs
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STRUCTURED_MODE=json_schema   # json_schema | json_object
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=4096
# Rough character budget for the prompt; candidates are trimmed to fit
LLM_MAX_PROMPT_CHARS=60000

# --- Recommendation engine -------------------------------------------------
RECOMMENDATION_CANDIDATE_LIMIT=40
RECOMMENDATION_MAX_RESULTS=8
# If true and every LLM provider fails, return a deterministic, clearly-labelled ranking
# instead of an error. Default false: failures surface as a 503 the UI can retry.
RECOMMENDATION_DETERMINISTIC_FALLBACK=true
# Fallback travel estimate when OSRM is not configured: straight line x detour factor at this speed.
# 22 km/h reflects Indian city traffic; every estimate is labelled "estimate" in the UI.
ASSUMED_AVG_SPEED_KMH=22
ROAD_DETOUR_FACTOR=1.35
# Optional self-hosted OSRM (see docs/routing.md), e.g. http://osrm:5000 . Empty = estimates.
OSRM_URL=
ITINERARY_MAX_STOPS=5

# --- Request understanding ------------------------------------------------------
# rules = deterministic English/Hinglish parser; llm = Gemini/Groq closed-schema parser (+ rules)
INTENT_PARSER=rules
# gemini = gemini-embedding-001 vectors (needs GEMINI_API_KEY + the embeddings agent); tfidf = offline
SEMANTIC_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Weather ----------------------------------------------------------------
WEATHER_PROVIDER=open_meteo     # open_meteo | mock | none
# Optional: Open-Meteo commercial API key (free tier needs no key)
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=600
# Open-Meteo air quality (US AQI, PM2.5); poor AQI downgrades outdoor places
AIR_QUALITY_ENABLED=true

# --- Review sentiment --------------------------------------------------------
SENTIMENT_BACKEND=lexicon       # lexicon | transformers (needs requirements-ml.txt)
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment
SENTIMENT_MIN_REVIEWS=3

# --- Entity resolution -------------------------------------------------------
MATCH_HIGH_THRESHOLD=0.80
MATCH_MEDIUM_THRESHOLD=0.60
MATCH_MAX_DISTANCE_M=400

# --- Frontend (build-time) ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Production hardening (see docs/AUDIT.md)
# Outbound HTTP pool shared by all provider clients; HTTP/2 needs httpx[http2] (in requirements.txt).
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=30
HTTP2_ENABLED=true
# Per-IP budget for POST /api/v1/recommendations and /refine (0 = off). Per process: use Redis when scaling out.
RATE_LIMIT_PER_MINUTE=20
# Only true behind a proxy you control; the rightmost X-Forwarded-For entry is then used as the client IP.
TRUST_FORWARDED_FOR=false
# Google Routes API (same key as PLACES_API_KEY; enable "Routes API"): live-traffic drive times + ranking
TRAFFIC_ROUTING_ENABLED=true
# Summarise Google reviews into likes / dislikes with the LLM (falls back to keyword analysis)
REVIEW_SUMMARY_LLM=true
