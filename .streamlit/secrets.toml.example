# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud → your app → Settings → Secrets. Never commit the real file.

# Google Maps Platform key: ratings, reviews and opening hours (Places API (New)) and live traffic
# (Routes API). Enable both APIs and billing on the key's Google Cloud project. Optional but recommended.
GOOGLE_MAPS_API_KEY = ""

# AI (optional): ranking, explanations and review summaries. One key is enough; with both, each task
# uses the better-suited model and the other is the fallback.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""

# Optional: identifies the app to OpenStreetMap/Wikipedia servers, as their usage policies ask.
CONTACT_EMAIL = ""
